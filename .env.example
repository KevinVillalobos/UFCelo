# Upstash Redis — visit counter en produccion (opcional)
# Si no se define, el contador cae a archivo local data/visits.json
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Token required (header X-Admin-Token) by PATCH /fighter/{id}/retire. Unset = endpoint disabled.
ADMIN_TOKEN=
# Allowed browser origins for CORS (comma-separated). Default: https://ufcelo.gg,https://www.ufcelo.gg
CORS_ORIGINS=
